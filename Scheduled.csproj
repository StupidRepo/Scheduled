<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net462</TargetFramework>
        <TargetFrameworkVersion>net462</TargetFrameworkVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <NoWarn>8618;MSB3026</NoWarn>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <Configurations>Debug;Release;FishNetGen</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="$(S1Dir)\Schedule I_Data\Managed\*.dll" Exclude="$(S1Dir)\Schedule I_Data\Managed\System*.dll;$(S1Dir)\Schedule I_Data\Managed\Unity*.dll;" Private="false" Publicize="True" />
    </ItemGroup>

    <!-- Use BepInEx's Assembly Publicizer to tell IDEs and the compiler that every field, method, etc. is public, in the game assemblies -->
    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="6.0.0-pre.1" />
        <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.733" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.32" PrivateAssets="all" />
        
        <!-- Fody-->
        <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
        <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
        
        <!-- MonoMod -->
        <PackageReference Include="MonoMod.Backports" Version="1.1.2" />
        <PackageReference Include="MonoMod.ILHelpers" Version="1.1.0" />
        <PackageReference Include="MonoMod.RuntimeDetour.HookGen" Version="22.7.31.1" />
    </ItemGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="Assets/sigmabundle"/>
    </ItemGroup>
    
    <Target Name="CopyOutputFileToGame" AfterTargets="Build">
        <Exec Command="&quot;$(MSBuildProjectDirectory)\Tools\FishNet.CodeGenerator.Cli.exe&quot; -i &quot;$(OutputPath)\$(AssemblyName).dll&quot; -a @(DepFolders->'&quot;%(Identity)&quot;', ' ')" Condition="'$(Configuration)' == 'FishNetGen'"/>
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="$(S1Dir)\BepInEx\plugins\" Retries="60"/>
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="$(UnityOutDir)" Retries="60"/>
    </Target>   

</Project>